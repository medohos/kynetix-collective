{
  "name": "kynetix-collective-backend",
  "version": "1.0.0",
  "description": "Kynetix Collective Sportswear - Node.js MVC Backend (Express & MySQL / XAMPP)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "node -e \"const fs=require('fs'),p=require('path');fs.mkdirSync('public',{recursive:true});for(const f of fs.readdirSync('.'))if(f.endsWith('.html')||f==='style.css'||f==='script.js')fs.copyFileSync(f,p.join('public',f));fs.cpSync('images','public/images',{recursive:true});\""
  },
  "keywords": [
    "kynetix",
    "sportswear",
    "mvc",
    "nodejs",
    "express",
    "mysql",
    "xampp"
  ],
  "author": "Kynetix Collective",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.9.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
